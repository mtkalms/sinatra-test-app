{
  "name": "ruby-sinatra-devcontainer",
  "dockerComposeFile": "../compose.yml",
  "service": "sinatra",
  "runServices": [
    "sinatra",
    "db"
  ],
  "workspaceFolder": "/opt/project",
  "postCreateCommand": [
    ".devcontainer/install_dependencies.sh"
  ],
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/opt/oracle/instantclient_23_8",
    "LD_LIBRARY_PATH": "/opt/oracle/instantclient_23_8",
    "TNS_ADMIN": "/opt/project/config",
    "NLS_LANG": "AMERICAN_AMERICA.AL32UTF8"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "aliariff.vscode-erb-beautify",
        "Shopify.ruby-lsp",
        "Oracle.sql-developer",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"

      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash",
            "args": [
              "--login"
            ]
          }
        }
      }
    }
  }
}