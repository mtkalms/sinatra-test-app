<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sinatra + React</title>
  </head>
  <body>
    <div id="root"></div>
    <% if settings.frontend_dev %>
      <%# In dev mode the bundle is served by webpack-dev-server with hot reloading. %>
      <script src="<%= request.scheme %>://<%= request.host %>:8080/bundle.js"></script>
    <% else %>
      <script src="/js/bundle.js"></script>
    <% end %>
  </body>
</html>
