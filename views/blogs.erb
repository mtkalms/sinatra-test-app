<h1 class="ui header">Blogs<h1>
<a href="/blogs/new">
  <button class="ui button green basic" type="submit">
    <i class="check icon"></i>
    Create Post
  </button>
</a>
<ul>
    <% @blogs.each do |blog| %>
        <li><a href="/blogs/<%= blog.id %>/view"><%= blog.name %></a></li>
    <% end %>
</ul>