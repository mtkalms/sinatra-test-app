<a class="" href="/blogs/<%=@blog.id%>/view">
  Back to Blog</a>
<h1 class="text-2xl">Posts in <%= @blog.name%>
</h1>
<a href="/blogs/<%=@blog.id%>/posts/new">
  <button class="bg-green">
    + Add Post
  </button>
</a>
<ul>
  <% @posts.each do |post| %>
    <li><a href="/posts/<%= post.id %>/view"><%= post.headline %></a></li>
  <% end %>
</ul>